# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Production URL (canonicals, sitemap, schema). Default: https://www.reservefundplans.com.au
NEXT_PUBLIC_SITE_URL=https://www.reservefundplans.com.au

# ── Google reCAPTCHA (spam protection on the quote form) ──
# Option 1: visible "I'm not a robot" checkbox. Create keys of type "Challenge (v2)" → "I'm not a robot" Checkbox.
#           If these are set, the checkbox is used.
NEXT_PUBLIC_RECAPTCHA_CHECKBOX_SITE_KEY=
RECAPTCHA_CHECKBOX_SECRET_KEY=
# Option 2: invisible, score-based (v3).
# Create at https://www.google.com/recaptcha/admin  → type "reCAPTCHA v3"
# Domains: reservefundplans.com.au, www.reservefundplans.com.au, <your-project>.vercel.app, localhost
# Site key (public; built into the pages, so redeploy after changing it)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key: set in Vercel only. Never commit it.
RECAPTCHA_SECRET_KEY=
# Optional: minimum score 0.0–1.0 (default 0.5; lower = more lenient)
RECAPTCHA_MIN_SCORE=0.5

# ── Quote form delivery: choose ONE ──
# A) The business mailbox (SMTP). Values are in cPanel → Email Accounts → Connect Devices, or Webmail → Configure Mail Client
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
#    QUOTE_TO_EMAIL below = who receives enquiries (comma-separated). If empty, they go to SMTP_USER's own inbox. QUOTE_FROM_EMAIL can stay empty.
# A2) Resend (https://resend.com), used only if SMTP is not set
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=
# B) Any webhook (Zapier, Make, a CRM)
QUOTE_WEBHOOK_URL=

# ── Google Analytics 4 (optional) ──
NEXT_PUBLIC_GA_ID=
