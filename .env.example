# Copy to .env.local for local development, and add the same names in your host's environment settings
# (e.g. Vercel → Project → Settings → Environment Variables). Never commit real values.

# Production URL, used for canonicals, the sitemap, Open Graph and structured data. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.reservefundplans.com.au

# ── Quote form email delivery (SMTP, server-side only) ──
# The mailbox that sends enquiries, e.g. a website@ mailbox on the business mail server.
SMTP_HOST=
# 465 = SSL from the start, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Who receives enquiries (comma-separated). If empty, they go to SMTP_USER's own inbox.
QUOTE_TO_EMAIL=
# Optional "From" header, e.g. Reserve Fund Plans <website@example.com.au>. Defaults to SMTP_USER.
QUOTE_FROM_EMAIL=

# ── Google reCAPTCHA v2 "I'm not a robot" checkbox (optional but recommended) ──
# Create a "Challenge (v2) → I'm not a robot Checkbox" key at https://www.google.com/recaptcha/admin
# Domains: reservefundplans.com.au, www.reservefundplans.com.au, your preview domain, localhost
# Site key is public (built into the pages: redeploy after changing it). Secret key: server only.
NEXT_PUBLIC_RECAPTCHA_CHECKBOX_SITE_KEY=
RECAPTCHA_CHECKBOX_SECRET_KEY=
